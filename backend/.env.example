# SERVER ONLY. Copy to .env and supply values privately.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Resolve this relative path from backend/, or supply an absolute path.
GOOGLE_APPLICATION_CREDENTIALS=.private/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
TURSO_DATABASE_URL=
TURSO_DATABASE_AUTH_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:5000
PUBLIC_API_URL=http://localhost:4000
FILE_MAX_BYTES=1048576
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_CHAT_MODEL=gemma4:31b
OLLAMA_AGENT_MODEL=nemotron-3-ultra
# Enable only with effective consent and an approved usage policy.
ODIN_CLOUD_PROCESSING_ALLOWED=false
CARTESIA_API_KEY=
CARTESIA_BASE_URL=https://api.cartesia.ai
CARTESIA_API_VERSION=2026-08-14
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_VOICE_ID=
